# Public build-time configuration only. API secrets belong in Worker secrets:
#   wrangler secret put GROQ_API_KEY
#   wrangler secret put GEMINI_API_KEY

# Leave empty for same-origin deployments; otherwise set the Worker origin.
VITE_API_BASE_URL=

# Optional asset overrides (defaults use public CDNs).
VITE_FFMPEG_CORE_BASE=
VITE_MEDIAPIPE_WASM_URL=
VITE_MEDIAPIPE_MODEL_URL=
